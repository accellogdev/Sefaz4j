<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>net.accellog</groupId>
	<artifactId>sefaz4j</artifactId>
	<version>1.0.0-alpha-1</version>
	<name>Accellog</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- https://mvnrepository.com/artifact/javax.xml.bind/jaxb-api -->
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/junit/junit -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.santuario</groupId>
			<artifactId>xmlsec</artifactId>
			<version>4.0.4</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.3.9</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.22.2</version>
		</dependency>

	</dependencies>

	<build>
		<resources>
			<!-- Filtragem (substituição de tokens ${...}) só se aplica fora de
				 schemas/** e endpoints/**: são XSDs bundled e o INI de
				 endpoints, sem tokens hoje, mas um "${...}" literal futuro
				 nesses arquivos não deve ser tratado como placeholder Maven. -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<excludes>
					<exclude>schemas/**</exclude>
					<exclude>endpoints/**</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<includes>
					<include>schemas/**</include>
					<include>endpoints/**</include>
				</includes>
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jvnet.jaxb2.maven2</groupId>
				<artifactId>maven-jaxb2-plugin</artifactId>
				<version>0.14.0</version>
				<dependencies>
					<!-- O JAXB RI que o plugin traz por padrão usa sun.misc.Unsafe.defineClass,
						 removido no JDK 24+; sobrescrever para uma versão >= 2.3.1 evita o
						 NoSuchMethodException durante o generate-sources. -->
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-xjc</artifactId>
						<version>2.3.5</version>
					</dependency>
					<dependency>
						<groupId>org.glassfish.jaxb</groupId>
						<artifactId>jaxb-runtime</artifactId>
						<version>2.3.9</version>
					</dependency>
					<!-- jaxb-xjc:2.3.5 espera o pacote antigo com.sun.tools.rngom.*, mas a versão
						 de rngom que ele resolve por padrão (2.3.0) foi renomeada para org.kohsuke.rngom.*;
						 4.0.5 mantém o pacote antigo. -->
					<dependency>
						<groupId>com.sun.xml.bind.external</groupId>
						<artifactId>rngom</artifactId>
						<version>4.0.5</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>xjc-mdfe</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/schemas/mdfe</schemaDirectory>
							<schemaIncludes>
								<schemaInclude>mdfe_v3.00.xsd</schemaInclude>
								<schemaInclude>enviMDFe_v3.00.xsd</schemaInclude>
								<schemaInclude>retEnviMDFe_v3.00.xsd</schemaInclude>
								<schemaInclude>consReciMDFe_v3.00.xsd</schemaInclude>
								<schemaInclude>retConsReciMDFe_v3.00.xsd</schemaInclude>
							</schemaIncludes>
							<generatePackage>net.accellog.sefaz4j.mdfe.model</generatePackage>
						</configuration>
					</execution>
					<execution>
						<id>xjc-nfe</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/schemas/nfe</schemaDirectory>
							<schemaIncludes>
								<schemaInclude>nfe_v4.00.xsd</schemaInclude>
								<schemaInclude>enviNFe_v4.00.xsd</schemaInclude>
								<schemaInclude>retEnviNFe_v4.00.xsd</schemaInclude>
								<schemaInclude>consReciNFe_v4.00.xsd</schemaInclude>
								<schemaInclude>retConsReciNFe_v4.00.xsd</schemaInclude>
							</schemaIncludes>
							<generatePackage>net.accellog.sefaz4j.nfe.model</generatePackage>
						</configuration>
					</execution>
					<execution>
						<id>xjc-cte</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/schemas/cte</schemaDirectory>
							<schemaIncludes>
								<schemaInclude>cte_v4.00.xsd</schemaInclude>
							</schemaIncludes>
							<generatePackage>net.accellog.sefaz4j.cte.model</generatePackage>
						</configuration>
					</execution>
					<execution>
						<id>xjc-nfse</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<schemaDirectory>src/main/resources/schemas/nfse</schemaDirectory>
							<schemaIncludes>
								<schemaInclude>DPS_v1.01.xsd</schemaInclude>
							</schemaIncludes>
							<generatePackage>net.accellog.sefaz4j.nfse.model</generatePackage>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/integration/**</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>integration-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes>
								<exclude>none</exclude>
							</excludes>
							<!-- Surefire's default includes (**/Test*.java, **/*Test.java, **/*Tests.java,
							     **/*TestCase.java) don't match every class under **/integration/** (e.g.
							     HomologacaoIntegrationTestCTe.java ends in "TestCTe", not "Test") — without
							     this, resetting excludes to "none" above isn't enough, such a class is simply
							     never picked up at all (not run, not skipped). Keep the standard patterns for
							     everything else and additionally include the whole integration package by path. -->
							<includes>
								<include>**/Test*.java</include>
								<include>**/*Test.java</include>
								<include>**/*Tests.java</include>
								<include>**/*TestCase.java</include>
								<include>**/integration/**/*.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<repositories>

		<repository>
			<id>spring-releases</id>
			<url>https://repo.spring.io/libs-release</url>
		</repository>

		<repository>
			<id>jcenter-release</id>
			<name>jcenter</name>
			<url>http://oss.jfrog.org/artifactory/oss-release-local/</url>
		</repository>

	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>spring-releases</id>
			<url>https://repo.spring.io/libs-release</url>
		</pluginRepository>
	</pluginRepositories>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/accellogdev/Sefaz4j</url>
		</repository>
	</distributionManagement>

</project>